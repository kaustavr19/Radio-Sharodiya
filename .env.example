# Keep the public gate disabled until the database and email service are ready.
VITE_BETA_GATE_ENABLED=false

# Server-only Vercel Function settings. Never prefix these with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_with_your_server_only_key
RESEND_API_KEY=re_replace_with_your_resend_key
BETA_FROM_EMAIL=Radio Sharodiya <beta@your-domain.example>
BETA_REPLY_TO=you@your-domain.example
BETA_ADMIN_EMAIL=you@your-domain.example
BETA_SITE_URL=https://your-radio-domain.example
BETA_SESSION_SECRET=replace-with-at-least-32-random-characters
